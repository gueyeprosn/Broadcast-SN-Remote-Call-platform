# ───────────────────────────────────────────────────────────────────────────────
# Broadcast SN Remote Call — configuration
# Copier en .env et renseigner. Ne JAMAIS committer le .env réel.
# ───────────────────────────────────────────────────────────────────────────────

# URL publique de l'application, sans slash final. Doit être en HTTPS en production.
APP_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://snrc:snrc@localhost:5432/snrc?schema=public"

# Secret de signature des sessions et des cookies participants.
# Générer avec :  openssl rand -base64 48
AUTH_SECRET="CHANGEZ-MOI-openssl-rand-base64-48"

# Secret de dérivation des clés de salle média (roomSecret, outputKey).
# Générer avec :  openssl rand -base64 48
MEDIA_SECRET="CHANGEZ-MOI-AUSSI-openssl-rand-base64-48"

# ── Moteur média ──────────────────────────────────────────────────────────────
# Origine du moteur WebRTC. Service public, ou votre instance auto-hébergée.
# ATTENTION : si vous auto-hébergez une version MODIFIÉE de VDO.Ninja,
# l'AGPL §13 vous oblige à proposer son code source à ses utilisateurs.
MEDIA_ENGINE_ORIGIN="https://vdo.ninja"
MEDIA_ENGINE_ID="vdoninja"

# ── Agent vMix (optionnel) ────────────────────────────────────────────────────
# Secret partagé avec packages/vmix-agent. Jamais dans une URL.
VMIX_AGENT_TOKEN=""

# ── Compte administrateur initial (utilisé seulement par `npm run db:seed`) ───
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD=""

# ── Rétention des données ─────────────────────────────────────────────────────
# Jours de conservation des données d'une session TERMINÉE (correspondants,
# invitations, événements, mappings vMix). Aucun média n'est jamais stocké.
RETENTION_DAYS="30"

# Jours de conservation du journal d'audit. 0 = JAMAIS purgé, et c'est le
# défaut : le journal est la trace de qui a fait quoi.
AUDIT_RETENTION_DAYS="0"

# Secret permettant à un planificateur de lancer la purge sans session
# utilisateur. Vide = purge manuelle uniquement (Admin → Rétention).
# openssl rand -base64 32
CRON_SECRET=""

# ── Divers ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="info"
