# ──────────────────────────────────────────────────────────────────────────────
# Broadcast SN Remote Call — variables de la pile Docker
# Copier en  deploy/.env  et renseigner. Ne jamais committer le fichier réel.
# ──────────────────────────────────────────────────────────────────────────────

# Nom de domaine servi par Nginx.
SERVER_NAME=remote.exemple.org

# URL publique de l'application. DOIT être en HTTPS : l'application refuse de
# démarrer en production avec une URL en clair, et getUserMedia ne fonctionne
# pas sur une origine non sécurisée.
APP_URL=https://remote.exemple.org

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=snrc
POSTGRES_USER=snrc
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Secrets applicatifs ───────────────────────────────────────────────────────
# openssl rand -base64 48   (48 octets minimum, valeurs DIFFÉRENTES)
AUTH_SECRET=
MEDIA_SECRET=

# ── Moteur média ──────────────────────────────────────────────────────────────
# Service public, ou votre instance auto-hébergée.
# ATTENTION : si vous auto-hébergez une version MODIFIÉE de VDO.Ninja, l'AGPL §13
# vous oblige à proposer son code source à ses utilisateurs.
MEDIA_ENGINE_ORIGIN=https://vdo.ninja
MEDIA_ENGINE_ID=vdoninja

# ── Agent vMix ────────────────────────────────────────────────────────────────
# Même valeur que SNRC_AGENT_TOKEN de l'agent sur le PC de régie.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VMIX_AGENT_TOKEN=

# ── Test de connexion de la salle de préparation ──────────────────────────────
# Serveurs STUN séparés par des virgules. Sans valeur, le test de connexion du
# correspondant n'identifie que les routes locales et l'interface le dit.
STUN_URLS=

# ── Rétention des données ─────────────────────────────────────────────────────
# Jours de conservation des données d'une session terminée.
RETENTION_DAYS=30

# Jours de conservation du journal d'audit. 0 = jamais purgé (défaut).
AUDIT_RETENTION_DAYS=0

# Secret du planificateur de purge. OBLIGATOIRE si le service `scheduler` est
# conservé dans docker-compose.yml. 24 caractères minimum.
# openssl rand -base64 32
CRON_SECRET=

# Heure UTC du passage quotidien de la purge, HH:MM.
PURGE_AT=04:17

LOG_LEVEL=info
