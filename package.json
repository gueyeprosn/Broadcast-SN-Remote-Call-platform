{
  "name": "broadcast-sn-remote-call",
  "version": "0.1.0",
  "private": true,
  "description": "Broadcast SN Remote Call — Professional Remote Contribution Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ./tests/register.mjs tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "pg": "8.13.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
